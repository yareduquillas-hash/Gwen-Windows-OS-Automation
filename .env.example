# ═══════════════════════════════════════════════════════
# 🔐 TELEGRAM — OBLIGATORIO
# ═══════════════════════════════════════════════════════
JARVIS_TELEGRAM_TOKEN=PON_TU_TOKEN_DE_BOTFATHER_AQUI
JARVIS_TELEGRAM_CHAT_ID=TU_CHAT_ID_NUMERICO_AQUI

# 📱 API SERVER (APP ANDROID)
JARVIS_API_PORT=8000
# ⚠️ Genera una clave única: python -c "import secrets; print(secrets.token_hex(24))"
JARVIS_API_KEY=pon_tu_api_key_unica_aqui
# Local-only default. Use a private VPN interface for Android on another device.
JARVIS_API_HOST=127.0.0.1
JARVIS_API_CORS_ORIGINS=http://localhost,capacitor://localhost
JARVIS_API_SSL_KEYFILE=
JARVIS_API_SSL_CERTFILE=
# Disabled by default. If enabled, only a small read-only allowlist is accepted.
JARVIS_ALLOW_SHELL=false
# Disabled by default. Requires separate review before enabling installer execution.
JARVIS_ALLOW_INSTALLERS=false
# Disabled by default. Natural-language AI output must not execute PC actions.
JARVIS_ALLOW_AI_ACTIONS=false


# ═══════════════════════════════════════════════════════
# 👤 PERSONALIZACIÓN
# ═══════════════════════════════════════════════════════
JARVIS_USER_NAME=Admin
JARVIS_USER_TITLE=Señor
JARVIS_LANG=es-ES
JARVIS_TTS_VOICE=es-ES-AlvaroNeural

# ═══════════════════════════════════════════════════════
# 🤖 PROVEEDORES DE IA (NVIDIA API / OpenRouter / Groq)
# ═══════════════════════════════════════════════════════
# Proveedor principal: "nvidia", "siliconflow", "openrouter", o "groq"
JARVIS_AI_PROVIDER=nvidia

# NVIDIA API (Gratis en build.nvidia.com - Claves nvapi-...)
NVIDIA_API_KEY=nvapi-pon_tu_clave_de_nvidia_aqui
NVIDIA_MODEL=deepseek-ai/deepseek-r1

# OpenRouter / Groq (Opcionales)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ═══════════════════════════════════════════════════════
# 🤖 MODELOS OPENCODE GO (CLI de respaldo)
# ═══════════════════════════════════════════════════════
# 💡 Recomendación de ahorro:
#   - Base → deepseek-v4-flash (barato, rápido, suficiente para 90% de tareas)
#   - Solo usa deepseek-v4-pro si la tarea requiere razonamiento profundo
#   - Activa protocolo G o M con comandos de voz cuando necesites más potencia
#
# Modelo base (económico, para el día a día)
OPENCODE_MODEL_BASE=opencode-go/deepseek-v4-flash
# Protocolo G (modelo potente cuando lo necesites)
OPENCODE_MODEL_G=opencode-go/deepseek-v4-pro
# Protocolo M (otro modelo potente alternativo)
OPENCODE_MODEL_M=opencode-go/qwen3.7-max
# Timeout para cada tarea opencode (segundos)
OPENCODE_TIMEOUT=300
# Ruta al binario de opencode (si el comando 'opencode' no funciona)
OPENCODE_BIN=%APPDATA%\npm\node_modules\opencode-ai\node_modules\opencode-windows-x64\bin\opencode.exe

# ═══════════════════════════════════════════════════════
# 🎵 SPOTIFY / MEDIOS — OPCIONAL
# ═══════════════════════════════════════════════════════
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# ═══════════════════════════════════════════════════════
# 🎤 RECONOCIMIENTO DE VOZ — OPCIONAL
# ═══════════════════════════════════════════════════════
STT_GOOGLE_API_KEY=

# ============================================
# 📤 ARCHIVOS GRANDES (>50MB) — OPCIONAL
# ============================================
# Google Drive (requiere crear proyecto en console.cloud.google.com)
GOOGLE_CREDENTIALS_FILE=%APPDATA%\GwenWindowsPro\credentials.json
GOOGLE_TOKEN_FILE=%APPDATA%\GwenWindowsPro\google_token.json
# transfer.sh (sin configuración, siempre disponible, 14 días)
TRANSFER_SH_URL=https://transfer.sh
TRANSFER_SH_MAX_DAYS=14
# ═══════════════════════════════════════════════════════
GFN_EXECUTABLE=%LOCALAPPDATA%\NVIDIA Corporation\GeForceNOW\CEF\GeForceNOW.exe
GFN_GAMING_VOLUME=75
GFN_QUEUE_TIMEOUT_MINUTES=20
GFN_QUEUE_POLL_INTERVAL=15
GFN_ACTION_DELAY=6
GFN_QUICK_GAMES=Fortnite,Apex Legends,Cyberpunk 2077,Destiny 2,Genshin Impact
# ⚠️ DEPRECADO: GFN_QUEUE_REGION era para el motor OCR v2, ya no se usa en v3.
# Se conserva solo por compatibilidad. Déjalo vacío.
GFN_QUEUE_REGION=

# ═══════════════════════════════════════════════════════
# 📁 RUTAS — OPCIONAL (tienen defaults)
# ═══════════════════════════════════════════════════════
JARVIS_DATA_DIR=data
JARVIS_DESCARGAS_DIR=data/descargas
JARVIS_ARCHIVOS_DIR=data/archivos
JARVIS_CACHE_DIR=data/cache
JARVIS_DB_PATH=%APPDATA%\GwenWindowsPro\jarvis_memoria.db
JARVIS_LOG_DIR=%APPDATA%\GwenWindowsPro\logs
JARVIS_SETTINGS_DIR=%APPDATA%\GwenWindowsPro\settings

# ═══════════════════════════════════════════════════════
# 🧩 MÓDULOS — OPCIONAL ("false" para desactivar)
# ═══════════════════════════════════════════════════════
MODULE_WIZARD=true
MODULE_SISTEMA=true
MODULE_RECONFIG=true
MODULE_CONVERSACION=true
MODULE_BATERIA=true
MODULE_MEDIOS=true
MODULE_VOLUMEN=true
MODULE_CLIPBOARD=true
MODULE_PORTAPAPELES=true
MODULE_ARCHIVOS=true
MODULE_DESCARGAS=true
MODULE_MEMORIA=true
MODULE_SECCIONES=true
MODULE_TAREAS=true
MODULE_PROTOCOLOS=true
MODULE_VOZ=true
MODULE_CAPTURAS=true
MODULE_VENTANAS=true
MODULE_PROCESOS=true
MODULE_SISTEMA_INFO=true
MODULE_NOTIFICACIONES=true
MODULE_GEFORCENOW=true

# ═══════════════════════════════════════════════════════
# ⚙️ COMPORTAMIENTO — OPCIONAL
# ═══════════════════════════════════════════════════════
RATE_LIMIT_MAX_PER_MINUTE=10
MESSAGE_MAX_AGE_SECONDS=15
CONTEXT_MAX_CHARS=2000
LOG_LEVEL=INFO
TIMEZONE=America/Mexico_City
